{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickTranslate",
  "mainBinaryName": "quicktranslate",
  "version": "0.1.0",
  "identifier": "dev.longfin.quicktranslate",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "panel",
        "title": "QuickTranslate",
        "width": 480,
        "height": 340,
        "minWidth": 380,
        "minHeight": 240,
        "visible": false,
        "skipTaskbar": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "alwaysOnTop": false,
        "visibleOnAllWorkspaces": true,
        "resizable": true,
        "minimizable": false,
        "maximizable": false,
        "focus": false,
        "center": false
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "QuickTranslate Settings",
        "width": 560,
        "height": 720,
        "minWidth": 460,
        "minHeight": 360,
        "visible": false,
        "center": true,
        "resizable": true,
        "decorations": true,
        "skipTaskbar": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb", "app"],
    "category": "Utility",
    "shortDescription": "Select text, press Ctrl+C twice, get a translation",
    "longDescription": "A tray app: select text, press Ctrl+C twice and a translation pops up next to the cursor. It uses the claude (Claude Code) or codex CLI you already have installed and logged in.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
