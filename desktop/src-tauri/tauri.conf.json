{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickTranslate",
  "mainBinaryName": "quicktranslate",
  "version": "0.1.0",
  "identifier": "dev.longfin.quicktranslate",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "panel",
        "title": "QuickTranslate",
        "width": 480,
        "height": 340,
        "minWidth": 380,
        "minHeight": 240,
        "visible": false,
        "skipTaskbar": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "focus": false,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb"],
    "category": "Utility",
    "shortDescription": "Select text, press Ctrl+C twice, get a translation",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
